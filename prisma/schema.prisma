generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (sans pooler) pour les migrations — fournie par l'intégration Neon de Vercel
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Rsvp {
  id        String   @id @default(cuid())
  name      String
  phone     String
  attending Boolean
  guests    Int      @default(1)
  // identifiants des événements choisis (content/site.ts > events[].id), ex. ["mosquee", "mairie"]
  events    String[] @default([])
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
